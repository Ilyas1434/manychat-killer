# ─────────────────────────────────────────────────────────────
#  Required — comment-to-DM dashboard
# ─────────────────────────────────────────────────────────────

# Zernio API key: https://zernio.com/dashboard/api-keys
ZERNIO_API_KEY=sk_...

# Run `npm run list` to print both of these.
ZERNIO_PROFILE_ID=
ZERNIO_ACCOUNT_ID=

# Your Instagram handle, shown in the sidebar. e.g. @yourhandle
NEXT_PUBLIC_IG_USERNAME=


# ─────────────────────────────────────────────────────────────
#  Optional — `npm run create` one-off automation script
# ─────────────────────────────────────────────────────────────
INSTAGRAM_POST_ID=
AUTOMATION_NAME=
KEYWORDS=
DM_MESSAGE=
COMMENT_REPLY=


# ─────────────────────────────────────────────────────────────
#  Optional — email collection (DM asks for an email, then sends one)
# ─────────────────────────────────────────────────────────────

# Brevo transactional email: https://app.brevo.com
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Protects GET /api/poller in production. Generate: openssl rand -hex 24
POLLER_SECRET=

# Optional: store email-collect configs in a GitHub Gist so dashboard
# edits persist without a redeploy. Token needs the `gist` scope.
# Vercel KV (below) takes priority if both are set.
CONFIG_GIST_ID=
GITHUB_GIST_TOKEN=


# ─────────────────────────────────────────────────────────────
#  Optional — reel pipeline
#  (detect a native IG reel upload, then cross-post it)
# ─────────────────────────────────────────────────────────────

# Protects GET /api/reel-watcher in production; send as ?secret= or
# the x-cron-secret header. Generate: openssl rand -hex 24
CRON_SECRET=

# Public URL of this deployment, e.g. https://your-app.vercel.app
PUBLIC_BASE_URL=

# Cross-post targets. Find the IDs with `npm run list`.
ZERNIO_LINKEDIN_ACCOUNT_ID=
ZERNIO_THREADS_ACCOUNT_ID=

# Telegram bot for notifications and approval buttons.
# Token from @BotFather; chat id is your own chat with the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional shared secret checked against Telegram's
# x-telegram-bot-api-secret-token header.
TELEGRAM_WEBHOOK_SECRET=

# Apify, to resolve a fresh reel video URL (Instagram CDN URLs expire).
# Free tier at apify.com.
APIFY_TOKEN=

# OpenAI: Whisper transcription + X/Threads draft generation.
OPENAI_API_KEY=

# YouTube Data API v3, to upload the reel as a Short.
# Get the refresh token once via `npm run oauth youtube`.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# X (Twitter) OAuth 2.0 app with tweet.write + offline.access.
# Get the refresh token once via `npm run oauth x`.
# X rotates the refresh token on each use; the app persists the new
# one to KV and falls back to this value.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=


# ─────────────────────────────────────────────────────────────
#  Optional — persistent state (recommended in production)
# ─────────────────────────────────────────────────────────────
# Vercel KV stores the last-seen reel id, pending drafts, rotated X
# refresh token, and email-collect configs. Without it the app still
# runs but loses that state across cold starts.
KV_REST_API_URL=
KV_REST_API_TOKEN=
