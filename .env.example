# ── Zernio API ──────────────────────────────────────────────
# Get from zernio.com/dashboard/api-keys
ZERNIO_API_KEY=sk_...

# Run `npm run list` to find these values
ZERNIO_PROFILE_ID=
ZERNIO_ACCOUNT_ID=

# ── Dashboard display ────────────────────────────────────────
# Your Instagram handle (shown in sidebar + status bar)
NEXT_PUBLIC_IG_USERNAME=@yourhandle

# ── One-off automation script (optional) ────────────────────
INSTAGRAM_POST_ID=
AUTOMATION_NAME=Reel DM Test
KEYWORDS=
DM_MESSAGE=Hey! Thanks for commenting — here's what you asked for 👇
COMMENT_REPLY=
